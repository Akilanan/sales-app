# Copy this file to ".env" and fill in to switch from local demo mode to the
# real Supabase backend. Leave blank/absent to run in local demo mode.
#
# Find these under Supabase -> Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PRODUCTION ONLY: a long random string used to harden operator PIN logins.
# Must be IDENTICAL to the OPERATOR_SECRET you pass to `npm run seed:prod`.
# Generate one e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Leave blank for local demo mode.
VITE_OPERATOR_SECRET=
